# OSS Risk Platform — örnek ortam değişkenleri.
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. Gerçek değerleri asla commit etmeyin.

# PostgreSQL bağlantısı (zorunlu). README'deki adımlarla oluşturulan ossrisk rolü ve veritabanı;
# süper kullanıcı (postgres) kullanmayın. Parolayı URL'e yazmak yerine PGPASSWORD kullanın.
DATABASE_URL=postgres://ossrisk@localhost:5432/ossrisk
PGPASSWORD=

# Sunucu yalnız bu adreste dinler; ağa açmayın (ADR-001). PORT 1–65535 arasında olmalı.
HOST=127.0.0.1
PORT=3001

# Yerel taramaya izin verilen kök dizinler. Windows'ta ';' ile ayrılır, örn. C:\Projeler;D:\Kod
# Boş bırakılırsa yerel klasör taraması kapalıdır (ADR-002).
SCAN_ROOTS=

# Uzak repo clone zaman aşımı (ms). Varsayılan 300000 (5 dk).
SCAN_CLONE_TIMEOUT_MS=300000

# Entegrasyon token'larını çözmek için anahtar. Yalnız token çözülürken denetlenir (D-14).
ENCRYPTION_KEY=

# Kayıt defterinden lisans zenginleştirme ve NOTICE (REQ-004, ADR-006). Yalnız paket adı ve sürümü
# registry.npmjs.org, pypi.org ve files.pythonhosted.org adreslerine gönderilir. on (varsayılan) | off
REGISTRY_ENRICHMENT=on
# İstek başına zaman aşımı (ms), 1–86400000, varsayılan 15000. Arşiv indirmede en az 60000 kullanılır.
REGISTRY_TIMEOUT_MS=15000
# Eşzamanlı kayıt defteri isteği sayısı, 1–32, varsayılan 4.
REGISTRY_CONCURRENCY=4
# Kurumsal vekil sunucu (yalnız HTTPS isteklerinde; HTTP_PROXY/ALL_PROXY okunmaz).
# NO_PROXY: ad, .alan, *.alan, alan[:port], IP adresi veya *; CIDR desteklenmez.
# HTTPS_PROXY=http://proxy.example.local:8080
# NO_PROXY=localhost,127.0.0.1

# Güvenlik açığı sorgusu (REQ-005, ADR-007). Kesin sürümü bilinen paketlerin ekosistemi, adı ve sürümü
# api.osv.dev adresine, CVSS için yalnız CVE kimliği services.nvd.nist.gov adresine gönderilir. on (varsayılan) | off
VULNERABILITY_LOOKUP=on
# Son taramaların günlük yeniden kontrolü (depo yeniden clone edilmez). on (varsayılan) | off
VULNERABILITY_RECHECK=on
# Yeniden kontrol aralığı (saat), 1–168, varsayılan 24.
VULNERABILITY_RECHECK_INTERVAL_HOURS=24
# OSV/NVD istek başına zaman aşımı (ms), 1–86400000, varsayılan 15000.
OSV_TIMEOUT_MS=15000
# Eşzamanlı OSV ayrıntı isteği sayısı, 1–32, varsayılan 4.
OSV_CONCURRENCY=4
# NVD CVSS sorgusunu kapatmak için false (OSV sorgusu sürer).
NVD_ENABLED=true
# İsteğe bağlı NVD API anahtarı: hız sınırı 30 sn'de 5 yerine 50 istek. Hiçbir logda, yanıtta veya ekranda gösterilmez.
# Gerçek anahtarı yalnız kendi .env dosyanıza yazın, bu dosyaya yazmayın.
NVD_API_KEY=

# Web (URL) güvenlik taraması (REQ-008, ADR-010). Yalnız buradaki hostlar taranabilir; boşsa web taraması kapalıdır.
# Virgül/boşlukla ayrılır: tam host (portal.sirket.local), alt alan joker (*.sirket.com.tr; apex hariç),
# IPv4 (10.1.2.3) veya [IPv6]. Şema/port/yol yazılmaz. Yalnız kendi ve şirketinizin sistemlerini ekleyin.
WEB_SCAN_ALLOWED_HOSTS=
# Web taraması istek başına zaman aşımı (ms), 1000–120000, varsayılan 15000.
WEB_SCAN_TIMEOUT_MS=15000
# İsteğe bağlı OWASP ZAP bağlayıcısı: çalışan ZAP daemon'unun API adresi (https:// veya http://127.0.0.1:PORT).
# Boşsa yalnız yerleşik pasif kontroller çalışır. Aktif tarama proje bazında "active" seçilince yapılır.
# ZAP_API_URL=http://127.0.0.1:8090
# ZAP API anahtarı (ZAP'ı başlatırken verdiğiniz api.key). Gerçek anahtarı yalnız kendi .env dosyanıza yazın.
ZAP_API_KEY=
