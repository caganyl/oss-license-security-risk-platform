# OSS Risk Platform — örnek ortam değişkenleri.
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. Gerçek değerleri asla commit etmeyin.

# PostgreSQL bağlantısı (zorunlu). Parolayı URL'e yazmak yerine PGPASSWORD kullanın.
DATABASE_URL=postgres://postgres@localhost:5432/oss_risk
PGPASSWORD=

# docker-compose.yml içindeki PostgreSQL servisi için.
POSTGRES_DB=oss_risk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Sunucu yalnız bu adreste dinler; ağa açmayın (ADR-001).
HOST=127.0.0.1
PORT=3001

# Yerel taramaya izin verilen kök dizinler. Windows'ta ';' ile ayrılır, örn. C:\Projeler;D:\Kod
# Boş bırakılırsa yerel klasör taraması kapalıdır (ADR-002).
SCAN_ROOTS=

# Uzak repo clone zaman aşımı (ms).
SCAN_CLONE_TIMEOUT_MS=120000

# Python ayrıştırıcılarını çalıştıracak yorumlayıcı (Windows'ta genelde "python").
PYTHON_BIN=python

# Entegrasyon token'larını çözmek için anahtar. Yalnız token çözülürken denetlenir (D-14).
ENCRYPTION_KEY=
