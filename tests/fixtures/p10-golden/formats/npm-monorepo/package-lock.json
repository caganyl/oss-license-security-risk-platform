{
  "name": "fixture-npm-monorepo",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "fixture-npm-monorepo",
      "version": "1.0.0",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "devDependencies": {
        "prettier": "3.2.5"
      }
    },
    "apps/web": {
      "name": "web",
      "version": "0.0.1",
      "dependencies": {
        "react": "18.2.0"
      }
    },
    "node_modules/app-a": {
      "resolved": "packages/app-a",
      "link": true
    },
    "node_modules/prettier": {
      "version": "3.2.5",
      "dev": true,
      "license": "MIT"
    },
    "node_modules/react": {
      "version": "18.2.0",
      "license": "MIT"
    },
    "packages/app-a": {
      "name": "app-a",
      "version": "0.1.0"
    }
  }
}
